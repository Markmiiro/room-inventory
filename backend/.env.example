# Copy to .env for local work. Production values live in Railway; see DEPLOY.md.
# APP_ENV=production makes the startup checks in app/config.py fatal.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/room_inventory
# SPEC 21 — whether the API asks for a password at all. Default false.
#
# With it false there is no login anywhere in the app and ANYONE WHO KNOWS THE
# BACKEND URL CAN READ AND WRITE EVERY RECORD — prices, customers, profit. The
# two variables below are not needed in that state. See README, "No password by
# default".
AUTH_ENABLED=false
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required only when AUTH_ENABLED=true; production refuses to start without it.
JWT_SECRET=
# Required whatever AUTH_ENABLED says: with no token to check, the origin
# restriction is one of the few things left (SPEC 21.3).
ALLOWED_ORIGINS=http://localhost:5173
# Generate: .venv/bin/python -c "from app.auth import hash_password; print(hash_password('...'))"
# There is no default password. Unset means nobody can log in (SPEC 8).
INITIAL_PASSWORD_HASH=
