# Copy to .env for local work. Production values live in Railway; see DEPLOY.md.
# APP_ENV=production makes the startup checks in app/config.py fatal.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/room_inventory
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173
# Generate: .venv/bin/python -c "from app.auth import hash_password; print(hash_password('...'))"
# There is no default password. Unset means nobody can log in (SPEC 8).
INITIAL_PASSWORD_HASH=
